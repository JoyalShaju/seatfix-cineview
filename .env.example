# CineView 3D Environment Variables Template
# Copy this file to .env.local for local development (never commit real secrets).

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Required from Phase 5 onward)
DATABASE_URL="postgresql://cineview:cineview_dev_password@localhost:5432/cineview_3d?schema=public"

# Authentication (Required from Phase 5 onward)
BETTER_AUTH_SECRET="replace-with-32-byte-random-hex-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Booking Configuration (Seconds)
SEAT_HOLD_DURATION_SECONDS=420
